{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sldr playlist schema",
  "description": "Configuration schema for sldr presentation playlists (playlist.toml)",
  "type": "object",
  "properties": {
    "default_lang": {
      "description": "Default language for slides with in-file language blocks\n(`::lang:xx::`). A suggestion, not identity — the build's --lang\ntakes precedence.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "description": {
      "description": "Optional description",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "flavor": {
      "description": "Default flavor to use",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "name": {
      "description": "Name of the playlist/presentation",
      "type": "string"
    },
    "render": {
      "description": "Rendering configuration",
      "$ref": "#/$defs/RenderOpts",
      "default": {
        "aspect_ratio": null,
        "canvas_width": null,
        "dark_mode": null,
        "drawings": null,
        "record": null,
        "theme": null,
        "title": null,
        "transition": null
      }
    },
    "slides": {
      "description": "List of slide references (names or paths)",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "title": {
      "description": "Optional title for the presentation",
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "name"
  ],
  "$defs": {
    "RenderOpts": {
      "description": "Presentation rendering configuration\n\nSerialized as the `[render]` table of a playlist (the legacy\n`[slidev_config]` key is still read for older playlist.toml files).\nControls transition style, aspect ratio, and other rendering options for\nthe self-contained HTML output.",
      "type": "object",
      "properties": {
        "aspect_ratio": {
          "description": "Aspect ratio hint for PDF/PPTX export viewport (e.g., \"16/9\", \"4/3\").\nThe HTML output is fully responsive and fills the browser viewport.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "canvas_width": {
          "description": "Canvas width hint in pixels for export (informational)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "dark_mode": {
          "description": "Start in dark mode",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "drawings": {
          "description": "Enable/disable drawing feature (reserved for future use)",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "record": {
          "description": "Enable slide recording (reserved for future use)",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "theme": {
          "description": "Theme name (reserved for future use)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "title": {
          "description": "Title override for the presentation",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "transition": {
          "description": "Transition effect between slides: \"fade\", \"slide-left\", \"slide-right\", \"none\"",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    }
  }
}