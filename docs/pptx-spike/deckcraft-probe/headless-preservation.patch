+/// Keep opaque non-visual metadata, not relationship references we cannot remap or the
+/// decorative marker that the writer regenerates from the editable model flag.
+fn nonvisual_extensions(part: &Part, nv: Option<&El>, props: &El) -> Option<String> {
+    let list = props.child("extLst")?;
+    let mut ns: Vec<_> = part.inner_ns.iter().chain(&part.ns).cloned().collect();
+    // Closest declarations win, including prefixes rebound differently on sibling shapes.
+    for scope in nv.into_iter().chain([props, list]) {
+        for (key, value) in scope.attrs.iter().filter(|(k, _)| k == "xmlns" || k.starts_with("xmlns:")) {
+            ns.retain(|(k, _)| k != key);
+            ns.push((key.clone(), value.clone()));
+        }
+    }
+    let kept: String = list
+        .children_named("ext")
+        .filter(|entry| entry.attr("uri") != Some(crate::DECORATIVE_EXT_URI) && !super::has_rel_refs(entry))
+        .map(|entry| {
+            let mut entry = entry.clone();
+            // keep_xml carries prefixed declarations; unprefixed payloads need the default too.
+            if !entry.has_attr("xmlns")
+                && let Some((_, uri)) = ns.iter().find(|(k, _)| k == "xmlns")
+            {
+                entry.set_attr("xmlns", uri);
+            }
+            super::keep_xml(&entry, &ns)
+        })
+        .collect();
+    (!kept.is_empty()).then_some(kept)
+}
