+//! Keep both the presence and value of a source picture's rotWithShape property.
+
+use std::io::{Cursor, Read, Write};
+use std::sync::Arc;
+
+use deckcraft_model::style::PictureFill;
+use deckcraft_model::{Presentation, Shape, ShapeId, ShapeKind, Xfrm};
+use zip::write::SimpleFileOptions;
+
+fn picture_deck() -> Presentation {
+    let mut p = Presentation::default();
+    let mut image = Cursor::new(Vec::new());
+    image::RgbaImage::from_pixel(2, 2, image::Rgba([10, 60, 100, 255])).write_to(&mut image, image::ImageFormat::Png).expect("original PNG");
+    let media = p.add_media("original.png", "image/png", image.into_inner()).expect("media id");
+    let id = ShapeId(p.alloc_id().expect("shape id"));
+    Arc::make_mut(&mut p.slides[0]).shapes.push(Shape {
+        id,
+        name: "Original picture".into(),
+        xfrm: Some(Xfrm::new(80.0, 100.0, 200.0, 120.0)),
+        kind: ShapeKind::Picture { fill: PictureFill { media, ..Default::default() } },
+        ..Default::default()
+    });
+    p
+}
+
+fn fixture(rotation: Option<bool>) -> Vec<u8> {
+    let original = deckcraft_pptx::export(&picture_deck()).expect("export");
+    let mut source = zip::ZipArchive::new(Cursor::new(original)).expect("ZIP");
+    let mut output = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    for i in 0..source.len() {
+        let entry = source.by_index(i).expect("entry");
+        if entry.name() != "ppt/slides/slide1.xml" {
+            output.raw_copy_file(entry).expect("copy unchanged part");
+            continue;
+        }
+        let xml = std::io::read_to_string(entry).expect("slide XML");
+        let replacement = match rotation {
+            None => "",
+            Some(false) => r#" rotWithShape="0""#,
+            Some(true) => r#" rotWithShape="1""#,
+        };
+        output.start_file("ppt/slides/slide1.xml", SimpleFileOptions::default()).expect("start slide");
+        output.write_all(xml.replace(r#" rotWithShape="1""#, replacement).as_bytes()).expect("write slide");
+    }
+    output.finish().expect("finish ZIP").into_inner()
+}
+
+fn rotation(bytes: &[u8]) -> Option<bool> {
+    let mut zip = zip::ZipArchive::new(Cursor::new(bytes)).expect("ZIP");
+    let mut xml = String::new();
+    zip.by_name("ppt/slides/slide1.xml").expect("slide").read_to_string(&mut xml).expect("XML");
+    let doc = deckcraft_pptx::parse_xml(xml.as_bytes()).expect("XML");
+    doc.root.find("blipFill").expect("picture fill").bool("rotWithShape")
+}
+
+#[test]
+fn picture_rotation_preserves_absent_true_and_false_source_properties() {
+    // Newly authored pictures retain the existing explicit-true serialization.
+    assert_eq!(rotation(&deckcraft_pptx::export(&picture_deck()).expect("new export")), Some(true));
+    for original in [None, Some(true), Some(false)] {
+        let source = fixture(original);
+        assert_eq!(rotation(&source), original);
+        let imported = deckcraft_pptx::import(&source).expect("import");
+        let saved = deckcraft_pptx::export(&imported).expect("save");
+        assert_eq!(rotation(&saved), original);
+        let saved_again = deckcraft_pptx::export(&deckcraft_pptx::import(&saved).expect("reimport")).expect("save again");
+        assert_eq!(rotation(&saved_again), original);
+    }
+}
+
+#[test]
+fn changing_an_implicit_picture_to_upright_writes_the_explicit_override() {
+    let mut imported = deckcraft_pptx::import(&fixture(None)).expect("import");
+    let shape = Arc::make_mut(&mut imported.slides[0]).shapes.iter_mut().find(|s| s.name == "Original picture").expect("picture");
+    let ShapeKind::Picture { fill } = &mut shape.kind else { panic!("picture kind") };
+    fill.upright = true;
+    let changed = deckcraft_pptx::export(&imported).expect("save change");
+    assert_eq!(rotation(&changed), Some(false));
+}
