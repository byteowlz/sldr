diff --git a/crates/pptx/tests/nonvisual_extensions.rs b/crates/pptx/tests/nonvisual_extensions.rs
new file mode 100644
index 0000000..a3067a6
--- /dev/null
+++ b/crates/pptx/tests/nonvisual_extensions.rs
@@ -0,0 +1,137 @@
+//! Relationship-free add-in identities in cNvPr survive import, native model storage and saves.
+//! Original synthetic metadata only; no third-party deck fixture.
+
+use std::collections::BTreeMap;
+use std::io::{Cursor, Read, Write};
+use std::sync::Arc;
+
+use deckcraft_pptx::{XmlEl, parse_xml};
+use quick_xml::{events::Event, name::ResolveResult, reader::NsReader};
+use zip::write::SimpleFileOptions;
+
+const DECORATIVE: &str = "{C183D7F6-B498-43B3-948B-1728B52AA6E4}";
+
+fn inject(el: &mut XmlEl, next: &mut usize) {
+    if el.is("cNvPr") && el.attr("name").is_some_and(|n| !n.is_empty()) {
+        *next += 1;
+        // Deliberately shadow the same prefix differently on sibling cNvPr elements.
+        // The saved extension must retain the closest binding, not the part's fallback.
+        el.set_attr("xmlns:proof", &format!("urn:deckcraft-test:identity:{next}"));
+        let fragment = format!(
+            r#"<a:extLst xmlns="urn:deckcraft-test:default:{next}"><a:ext uri="urn:deckcraft-test:opaque"><proof:identity id="proof-{next}" label="A &amp; B"/><identity id="default-{next}"/></a:ext><a:ext uri="urn:deckcraft-test:relationship"><proof:linked r:id="rIdMustNotDangle"/></a:ext></a:extLst>"#
+        );
+        let list = parse_xml(fragment.as_bytes()).expect("synthetic extension list").root;
+        if let Some(existing) = el.elements_mut().find(|e| e.is("extLst")) {
+            existing.set_attr("xmlns", &format!("urn:deckcraft-test:default:{next}"));
+            existing.children.extend(list.children);
+        } else {
+            let wrapper = parse_xml(format!("<wrap>{}</wrap>", list.to_xml()).as_bytes()).expect("wrapper");
+            el.children.extend(wrapper.root.children);
+        }
+    }
+    for child in el.elements_mut() {
+        inject(child, next);
+    }
+}
+
+fn fixture() -> (Vec<u8>, usize) {
+    let mut session = deckcraft_engine::Session::new();
+    deckcraft_engine::sample::open_sample(&mut session).expect("sample");
+    let mut doc = session.doc().expect("document").doc.as_ref().clone();
+    Arc::make_mut(&mut doc.slides[0]).shapes[0].decorative = true;
+    let bytes = deckcraft_pptx::export(&doc).expect("export sample");
+    let mut source = zip::ZipArchive::new(Cursor::new(bytes)).expect("zip");
+    let mut target = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    let mut count = 0;
+    for i in 0..source.len() {
+        let mut entry = source.by_index(i).expect("entry");
+        let name = entry.name().to_owned();
+        let mut data = Vec::new();
+        entry.read_to_end(&mut data).expect("read");
+        if name.starts_with("ppt/slides/slide") && name.ends_with(".xml") {
+            let mut doc = parse_xml(&data).expect("slide XML");
+            inject(&mut doc.root, &mut count);
+            data = doc.root.to_xml().into_bytes();
+        }
+        target.start_file(name, SimpleFileOptions::default()).expect("start part");
+        target.write_all(&data).expect("write part");
+    }
+    (target.finish().expect("finish").into_inner(), count * 2)
+}
+
+/// Read resolved namespace URIs as well as ids: unbound/wrong prefixes must not pass.
+fn identities(bytes: &[u8]) -> BTreeMap<String, String> {
+    let mut zip = zip::ZipArchive::new(Cursor::new(bytes)).expect("zip");
+    let mut found = BTreeMap::new();
+    for i in 0..zip.len() {
+        let mut entry = zip.by_index(i).expect("entry");
+        if !entry.name().starts_with("ppt/slides/slide") || !entry.name().ends_with(".xml") {
+            continue;
+        }
+        let mut xml = String::new();
+        entry.read_to_string(&mut xml).expect("XML");
+        let mut reader = NsReader::from_str(&xml);
+        loop {
+            let (namespace, event) = reader.read_resolved_event().expect("resolved XML");
+            match event {
+                Event::Start(e) | Event::Empty(e) if e.local_name().as_ref() == b"identity" => {
+                    let ResolveResult::Bound(namespace) = namespace else { panic!("unbound identity namespace") };
+                    let id = e.attributes().map(|a| a.expect("attribute")).find(|a| a.key.as_ref() == b"id").expect("id");
+                    let id = id.normalized_value(quick_xml::XmlVersion::Implicit1_0).expect("id value").into_owned();
+                    let uri = std::str::from_utf8(namespace.as_ref()).expect("URI").to_owned();
+                    assert!(found.insert(id, uri).is_none(), "identity duplicated");
+                }
+                Event::Eof => break,
+                _ => {}
+            }
+        }
+    }
+    found
+}
+
+fn first_slide_xml(bytes: &[u8]) -> String {
+    let mut zip = zip::ZipArchive::new(Cursor::new(bytes)).expect("zip");
+    std::io::read_to_string(zip.by_name("ppt/slides/slide1.xml").expect("slide 1")).expect("XML")
+}
+
+#[test]
+fn nonvisual_identities_survive_import_model_serialization_and_two_saves() {
+    let (original, count) = fixture();
+    assert!(count > 10, "exercise multiple shape kinds and slides");
+    let expected = identities(&original);
+    assert_eq!(expected.len(), count);
+    let imported = deckcraft_pptx::import(&original).expect("import");
+    // The same serde model is carried by the native .deckcraft manifest.
+    let stored = serde_json::to_vec(&imported).expect("serialize native model");
+    let reopened = serde_json::from_slice(&stored).expect("deserialize native model");
+    let saved = deckcraft_pptx::export(&reopened).expect("export");
+    assert_eq!(identities(&saved), expected);
+    let again = deckcraft_pptx::export(&deckcraft_pptx::import(&saved).expect("reimport")).expect("second export");
+    assert_eq!(identities(&again), expected);
+}
+
+#[test]
+fn retained_entries_share_one_list_with_editable_decoration_and_no_dangling_relationships() {
+    let (original, _) = fixture();
+    let mut imported = deckcraft_pptx::import(&original).expect("import");
+    let saved = deckcraft_pptx::export(&imported).expect("export");
+    let xml = first_slide_xml(&saved);
+    assert!(!xml.contains("rIdMustNotDangle"));
+    assert!(xml.contains(DECORATIVE));
+    let doc = parse_xml(xml.as_bytes()).expect("XML");
+    let mut properties = Vec::new();
+    doc.root.find_all("cNvPr", &mut properties);
+    for props in properties {
+        assert!(props.children_named("extLst").count() <= 1, "one extension list per cNvPr");
+    }
+    Arc::make_mut(&mut imported.slides[0]).shapes[0].decorative = false;
+    let changed = deckcraft_pptx::export(&imported).expect("export changed decoration");
+    assert!(!first_slide_xml(&changed).contains(DECORATIVE), "no stale retained decorative entry");
+    assert_eq!(identities(&changed), identities(&original));
+}
+
+#[test]
+fn legacy_native_shape_without_new_metadata_field_still_loads() {
+    let shape: deckcraft_model::Shape = serde_json::from_str(r#"{"name":"legacy"}"#).expect("legacy shape");
+    assert_eq!(shape.name, "legacy");
+}
